# Existing bot configuration (keep credentials outside Git)
DISCORD_TOKEN=
OPENROUTER_API_KEY=
# Optional API key for welcome GIFs.
GIPHY_API_KEY=
MONGO_URI=
DEV_IDS=
# ID of the private channel for moderation logs. Leave empty to disable.
MOD_LOG_CHANNEL_ID=

# Server butler. No AI/API key is needed for the butler.
BUTLER_ENABLED=true
# Administrators and server owner always exempt from Butler anti-ping deletion.
BUTLER_ANTI_PING_DELETE=true
# alert (default), off, or delete (explicit opt-in for privileged-account spam cleanup).
PRIVILEGED_SPAM_MODE=alert
# Comma-separated channel IDs exempt from Butler and privileged spam enforcement.
# Threads inherit their parent's exemption. Restart after editing these settings.
AUTO_MOD_TRUSTED_CHANNEL_IDS=
# Empty means the Discord application's owner (team owner for team apps).
BUTLER_OWNER_ID=
# Empty means all connected guilds; otherwise comma-separated guild IDs.
BUTLER_GUILD_IDS=
BUTLER_TIMEZONE=Asia/Kolkata
# Previous day's ledger, daily at 00:05 local time by default.
BUTLER_REPORT_HOUR=0
BUTLER_REPORT_MINUTE=5
BUTLER_RETENTION_DAYS=30

# Public creator username shown in the bot application description.
BOT_CREATOR_NAME=luffyanna
