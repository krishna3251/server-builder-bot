# Existing bot configuration (keep credentials outside Git)
DISCORD_TOKEN=
OPENROUTER_API_KEY=
MONGO_URI=
DEV_IDS=

# Server butler. No AI/API key is needed for the butler.
BUTLER_ENABLED=true
# Empty means the Discord application's owner (team owner for team apps).
BUTLER_OWNER_ID=
# Empty means all connected guilds; otherwise comma-separated guild IDs.
BUTLER_GUILD_IDS=
BUTLER_TIMEZONE=Asia/Kolkata
# Previous day's ledger, daily at 00:05 local time by default.
BUTLER_REPORT_HOUR=0
BUTLER_REPORT_MINUTE=5
BUTLER_RETENTION_DAYS=30

# Public creator username shown in the bot application description.
BOT_CREATOR_NAME=luffyanna
